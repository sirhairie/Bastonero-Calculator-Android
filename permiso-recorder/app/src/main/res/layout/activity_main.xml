<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:background="@color/cloud">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="66dp"
        android:paddingStart="14dp"
        android:paddingEnd="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:background="@drawable/toolbar_gradient">
        <ImageView
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:contentDescription="@string/app_name"
            android:src="@drawable/brand_mark" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="9dp"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/heading"
                android:textColor="#FFFFFF"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.025"
                android:textSize="14sp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/subtitle"
                android:textColor="#D1E4F3"
                android:textSize="10sp"
                android:layout_marginTop="1dp" />
        </LinearLayout>
        <ImageButton
            android:id="@+id/reloadButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/action_button"
            android:src="@drawable/ic_refresh"
            android:contentDescription="@string/reload"
            android:scaleType="centerInside"
            android:padding="11dp"
            android:tint="#FFFFFF" />
        <ImageButton
            android:id="@+id/browserButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/action_button"
            android:src="@drawable/ic_open"
            android:contentDescription="@string/browser"
            android:scaleType="centerInside"
            android:padding="11dp"
            android:tint="#FFFFFF" />
    </LinearLayout>
    <ProgressBar
        android:id="@+id/loadingBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:max="100"
        android:indeterminate="false"
        android:progressTint="@color/teal"
        android:progressBackgroundTint="#E9EEF3" />
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <WebView
            android:id="@+id/recorderWebView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#FFFFFF" />
        <LinearLayout
            android:id="@+id/errorPanel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/cloud"
            android:padding="30dp"
            android:gravity="center"
            android:visibility="gone"
            android:orientation="vertical">
            <ImageView
                android:layout_width="78dp"
                android:layout_height="78dp"
                android:src="@drawable/brand_mark"
                android:contentDescription="@null" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/error_title"
                android:textColor="@color/ink"
                android:textSize="20sp"
                android:fontFamily="sans-serif-medium"
                android:gravity="center" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/error_description"
                android:textColor="@color/subtle"
                android:textSize="14sp"
                android:gravity="center" />
            <Button
                android:id="@+id/retryButton"
                android:layout_width="190dp"
                android:layout_height="50dp"
                android:layout_marginTop="25dp"
                android:background="@drawable/retry_button"
                android:text="@string/try_again"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="15sp" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
