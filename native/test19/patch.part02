
        try{
            Drawable medal=getDrawable(R.drawable.ic_medal);
            if(medal!=null){
                medal=medal.mutate();
                medal.setTint(accent);
                medal.setBounds((int)x,(int)y,(int)(x+w),(int)(y+h));
                medal.draw(cv);
            }
        }catch(Exception ignored){}
        float cx=x+w/2f,cy=y+h*.58f;
        p.setColor(Color.argb(220,255,232,164));cv.drawCircle(cx,cy,31,p);
        p.setStyle(Paint.Style.STROKE);p.setStrokeWidth(2);p.setColor(GOLD_LIGHT);cv.drawCircle(cx,cy,31,p);p.setStyle(Paint.Style.FILL);
        drawText(cv,p,String.valueOf(rank),cx,cy+11,29,Color.BLACK,true,Paint.Align.CENTER);
    }

    private void drawExportMetricBox(Canvas cv,Paint p,String label,String value,float x,float y,float w,float h,int accent,boolean emphasize){
        p.setColor(Color.rgb(10,45,78));cv.drawRoundRect(x,y,x+w,y+h,15,15,p);
        p.setStyle(Paint.Style.STROKE);p.setStrokeWidth(emphasize?2.2f:1.4f);p.setColor(emphasize?accent:LINE);
        cv.drawRoundRect(x,y,x+w,y+h,15,15,p);p.setStyle(Paint.Style.FILL);
        drawText(cv,p,label,x+w/2f,y+27,14,MUTED,true,Paint.Align.CENTER);
        drawText(cv,p,value,x+w/2f,y+61,emphasize?27:25,emphasize?accent:WHITE,true,Paint.Align.CENTER);
    }

    private void drawExportJudgeBox(Canvas cv,Paint p,String label,String value,float x,float y,float w,float h){
        p.setColor(Color.rgb(7,29,53));cv.drawRoundRect(x,y,x+w,y+h,13,13,p);
        p.setStyle(Paint.Style.STROKE);p.setStrokeWidth(1.3f);p.setColor(LINE);
        cv.drawRoundRect(x,y,x+w,y+h,13,13,p);p.setStyle(Paint.Style.FILL);
        drawText(cv,p,label,x+w/2f,y+25,14,MUTED,true,Paint.Align.CENTER);
        drawText(cv,p,value,x+w/2f,y+55,23,WHITE,true,Paint.Align.CENTER);
    }

    private void drawExportTieTotal(Canvas cv,Paint p,String value,float x,float y,float w,float h){
        p.setShadowLayer(14,0,0,Color.argb(150,255,199,65));
        p.setColor(Color.rgb(65,52,18));cv.drawRoundRect(x,y,x+w,y+h,14,14,p);
        p.clearShadowLayer();
        p.setStyle(Paint.Style.STROKE);p.setStrokeWidth(2.4f);p.setColor(GOLD_LIGHT);
        cv.drawRoundRect(x,y,x+w,y+h,14,14,p);p.setStyle(Paint.Style.FILL);
        drawText(cv,p,"5-JUDGE TOTAL SCORE",x+w/2f,y+25,13,GOLD_LIGHT,true,Paint.Align.CENTER);
        drawText(cv,p,value,x+w/2f,y+57,26,GOLD_2,true,Paint.Align.CENTER);
    }

    private float premiumTextWidth(Paint p,String value,float size,boolean bold){
        p.setTypeface(bold?Typeface.DEFAULT_BOLD:Typeface.DEFAULT);p.setTextSize(size);return p.measureText(value);
    }

    private void drawTextCenteredFit(Canvas cv,Paint p,String value,float x,float y,float startSize,int color,boolean bold,float maxWidth){
        float size=startSize;
        p.setTypeface(bold?Typeface.DEFAULT_BOLD:Typeface.DEFAULT);
        p.setTextAlign(Paint.Align.CENTER);p.setTextSize(size);
        while(size>15&&p.measureText(value)>maxWidth){size-=1.5f;p.setTextSize(size);}
        drawText(cv,p,value,x,y,size,color,bold,Paint.Align.CENTER);
    }''', 'TEST 19 ranking-matched portrait result export')

