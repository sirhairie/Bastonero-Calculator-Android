        LinearLayout row=surfaceCard();row.setPadding(dp(10),dp(9),dp(10),dp(9));LinearLayout top=new LinearLayout(this);top.setOrientation(LinearLayout.HORIZONTAL);top.setGravity(Gravity.CENTER_VERTICAL);TextView num=circleNumber(String.valueOf(index+1),MUTED);top.addView(num,new LinearLayout.LayoutParams(dp(36),dp(36)));LinearLayout info=new LinearLayout(this);info.setOrientation(LinearLayout.VERTICAL);info.setPadding(dp(9),0,0,0);info.addView(text(safeName(e.name),14,WHITE,true));info.addView(text("ID: "+String.format(Locale.US,"%03d",e.id)+(e.school.isEmpty()?"":"  •  "+e.school),10,MUTED,false));top.addView(info,new LinearLayout.LayoutParams(0,-2,1f));ScoreData d=scoreData(e);TextView score=pill(d.complete?fmt(d.net):(c.scoringStarted?"PENDING":"REGISTERED"),Color.WHITE,d.complete?GREEN:Color.rgb(65,82,105));top.addView(score);row.addView(top);
        if(c.scoringStarted){row.setClickable(true);row.setOnClickListener(v->jumpToScore(e.id));}else{LinearLayout actions=new LinearLayout(this);actions.setOrientation(LinearLayout.HORIZONTAL);actions.setPadding(0,dp(8),0,0);Button edit=outlineButton("Edit",GREEN);edit.setOnClickListener(v->openEntryDialog(c,e));Button remove=outlineButton("Remove",RED);remove.setOnClickListener(v->confirmDeleteEntry(c,e));actions.addView(edit,new LinearLayout.LayoutParams(0,dp(38),1f));LinearLayout.LayoutParams rp=new LinearLayout.LayoutParams(0,dp(38),1f);rp.setMargins(dp(7),0,0,0);actions.addView(remove,rp);row.addView(actions);}return row;
    }

    private View scoringGuide(){
        LinearLayout box=darkCard();box.setPadding(dp(12),dp(11),dp(12),dp(11));LinearLayout top=row();TextView icon=badgeSquare("◆",CARD_2);top.addView(icon,new LinearLayout.LayoutParams(dp(38),dp(38)));LinearLayout txt=new LinearLayout(this);txt.setOrientation(LinearLayout.VERTICAL);txt.setPadding(dp(9),0,0,0);txt.addView(text("JUDGES SCORING GUIDE",11,Color.rgb(120,164,255),true));txt.addView(text("Registration is locked. Remove the highest and lowest scores; the middle three are summed, then penalty is subtracted.",10,MUTED,false));top.addView(txt,new LinearLayout.LayoutParams(0,-2,1f));box.addView(top);return box;
    }

    private View scoringPanel(Competition c){
        LinearLayout panel=new LinearLayout(this);panel.setOrientation(LinearLayout.VERTICAL);LinearLayout head=row();head.setGravity(Gravity.CENTER_VERTICAL);head.addView(text("JUDGES SCORING",13,WHITE,true),new LinearLayout.LayoutParams(0,-2,1f));head.addView(text("Valid 7.0 – 10.0",10,MUTED,false));panel.addView(head);for(int i=0;i<c.entries.size();i++)panel.addView(scoreCard(c,c.entries.get(i),i),fullMargins(0,dp(9),0,0));return panel;
    }

    private View scoreCard(Competition c,Entry e,int index){
        LinearLayout card=darkCard();card.setTag("score_"+e.id);LinearLayout head=row();head.setGravity(Gravity.CENTER_VERTICAL);TextView n=circleNumber(String.valueOf(index+1),BLUE_2);head.addView(n,new LinearLayout.LayoutParams(dp(38),dp(38)));LinearLayout info=new LinearLayout(this);info.setOrientation(LinearLayout.VERTICAL);info.setPadding(dp(9),0,0,0);info.addView(text(safeName(e.name),15,WHITE,true));info.addView(text("ID: "+String.format(Locale.US,"%03d",e.id)+(e.school.isEmpty()?"":"  •  "+e.school),10,MUTED,false));head.addView(info,new LinearLayout.LayoutParams(0,-2,1f));card.addView(head);
        LinearLayout judges=row();judges.setPadding(0,dp(11),0,0);for(int i=0;i<5;i++){LinearLayout.LayoutParams p=weight();if(i>0)p.setMargins(dp(5),0,0,0);judges.addView(judgeCell(e,i),p);}card.addView(judges);
        ScoreData d=scoreData(e);LinearLayout metrics=row();metrics.setPadding(0,dp(11),0,0);metrics.addView(metricBox("REMOVED H/L",d.complete?fmt1(d.high)+" / "+fmt1(d.low):"—",MUTED),weight());LinearLayout.LayoutParams m2=weight();m2.setMargins(dp(6),0,0,0);metrics.addView(metricBox("VALID SCORE",d.complete?fmt(d.score):"—",GOLD_2),m2);LinearLayout.LayoutParams m3=weight();m3.setMargins(dp(6),0,0,0);metrics.addView(penaltyBox(e),m3);card.addView(metrics);
        Button update=primaryButton(d.complete?"Update Result":"Calculate / Update Result",BLUE_2);update.setOnClickListener(v->{hideKeyboard();if(hasInvalidScore(e)){toast("Judge scores must be between 7.0 and 10.0");return;}refreshAt(e.id);});card.addView(update,fullMargins(0,dp(10),0,0,dp(48)));return card;
    }

    private View penaltyBox(Entry e){
        LinearLayout b=surfaceCard();b.setPadding(dp(7),dp(7),dp(7),dp(7));TextView l=text("PENALTY",8,MUTED,true);l.setGravity(Gravity.CENTER);b.addView(l);LinearLayout ctr=row();ctr.setGravity(Gravity.CENTER);Button minus=miniSquare("−",Color.rgb(47,66,91));Button plus=miniSquare("+",BLUE_2);TextView v=text(fmt1(e.penalty),13,WHITE,true);v.setGravity(Gravity.CENTER);minus.setOnClickListener(x->{e.penalty=Math.max(0,e.penalty-0.5);saveState();refreshAt(e.id);});plus.setOnClickListener(x->{e.penalty=Math.min(99,e.penalty+0.5);saveState();refreshAt(e.id);});ctr.addView(minus,new LinearLayout.LayoutParams(dp(30),dp(30)));ctr.addView(v,new LinearLayout.LayoutParams(0,dp(30),1f));ctr.addView(plus,new LinearLayout.LayoutParams(dp(30),dp(30)));b.addView(ctr);return b;
    }

    private View judgeCell(Entry e,int idx){
        LinearLayout box=new LinearLayout(this);box.setOrientation(LinearLayout.VERTICAL);TextView label=text("J"+(idx+1),8,MUTED,true);label.setGravity(Gravity.CENTER);box.addView(label);EditText input=input(e.scores[idx],"—",true);input.setGravity(Gravity.CENTER);input.setTextSize(15);input.setSingleLine(true);input.setSelectAllOnFocus(true);input.setPadding(dp(2),0,dp(2),0);input.setImeOptions(idx<4?EditorInfo.IME_ACTION_NEXT:EditorInfo.IME_ACTION_DONE);styleJudgeInput(input,e.scores[idx]);input.addTextChangedListener(new SimpleWatcher(){public void afterTextChanged(Editable s){e.scores[idx]=s.toString();styleJudgeInput(input,s.toString());saveState();}});input.setOnEditorActionListener((v,action,event)->{if(idx==4&&(action==EditorInfo.IME_ACTION_DONE||(event!=null&&event.getKeyCode()==KeyEvent.KEYCODE_ENTER))){hideKeyboard();refreshAt(e.id);return true;}return false;});LinearLayout.LayoutParams p=new LinearLayout.LayoutParams(-1,dp(48));p.setMargins(0,dp(4),0,0);box.addView(input,p);return box;
    }

    private void showRanking(){
        if(activeCompetition==null){showHome();return;}screen=Screen.RANKING;clearContent();Competition c=activeCompetition;addScreenHeader("Ranking",c.meet,true);ArrayList<ResultRow> rows=analyze(c);
        LinearLayout summary=darkCard();summary.addView(text("RESULTS SUMMARY",11,Color.rgb(124,166,255),true));TextView expl=text("Winners ranked after applying penalties. Final Score determines ranking; tied Final Scores use the 5-judge total.",10,MUTED,false);expl.setPadding(0,dp(4),0,0);summary.addView(expl);content.addView(summary,fullMargins(0,0,0,dp(10)));
        if(rows.isEmpty()){content.addView(infoCard("No completed scores","Return to scoring and complete all five judge scores."));}
        else{for(ResultRow r:rows)content.addView(rankCard(r),fullMargins(0,0,0,dp(10)));}
        LinearLayout tie=darkCard();tie.addView(text("ⓘ   TIE HANDLING",11,Color.rgb(124,166,255),true));TextView rule=text("If Final Scores are equal, the higher 5-judge total ranks higher. If both Final Score and 5-judge total are equal, Repeat Performance is required.",10,MUTED,false);rule.setPadding(0,dp(5),0,0);tie.addView(rule);content.addView(tie,fullMargins(0,0,0,dp(12)));
        Button save=primaryButton("Save Result",RED);save.setEnabled(!rows.isEmpty());save.setAlpha(rows.isEmpty()?0.45f:1f);save.setOnClickListener(v->saveResultImage(c,rows));content.addView(save,new LinearLayout.LayoutParams(-1,dp(52)));Button back=outlineButton("←  Back to Scoring",BLUE_2);back.setOnClickListener(v->showWorkspace());content.addView(back,fullMargins(0,dp(9),0,0,dp(46)));addFooter();
    }

    private View rankCard(ResultRow r){
        int accent=medalAccent(r);LinearLayout card=darkCard(accent);LinearLayout top=row();top.setGravity(Gravity.CENTER_VERTICAL);TextView medal=circleNumber(String.valueOf(r.rank),accent);medal.setTextSize(18);top.addView(medal,new LinearLayout.LayoutParams(dp(52),dp(52)));LinearLayout info=new LinearLayout(this);info.setOrientation(LinearLayout.VERTICAL);info.setPadding(dp(10),0,0,0);info.addView(text(safeName(r.entry.name),17,WHITE,true));info.addView(text("ID: "+String.format(Locale.US,"%03d",r.entry.id)+(r.entry.school.isEmpty()?"":"  •  "+r.entry.school),10,MUTED,false));top.addView(info,new LinearLayout.LayoutParams(0,-2,1f));TextView badge=pill(shortRemark(r),Color.WHITE,Color.argb(255,Math.max(0,Color.red(accent)-50),Math.max(0,Color.green(accent)-50),Math.max(0,Color.blue(accent)-50)));top.addView(badge);card.addView(top);
        View div=divider();LinearLayout.LayoutParams dp1=new LinearLayout.LayoutParams(-1,dp(1));dp1.setMargins(0,dp(11),0,dp(10));card.addView(div,dp1);
