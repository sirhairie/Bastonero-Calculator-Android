        LinearLayout metrics=row();metrics.addView(rankStat("Valid Score",fmt(r.data.score),WHITE),weight());LinearLayout.LayoutParams a=weight();a.setMargins(dp(6),0,0,0);metrics.addView(rankStat("Penalty",fmt1(r.data.penalty),WHITE),a);LinearLayout.LayoutParams b=weight();b.setMargins(dp(6),0,0,0);metrics.addView(rankStat("Final Score",fmt(r.data.net),WHITE),b);card.addView(metrics);
        TextView removed=text("Removed High / Low     "+fmt1(r.data.high)+" / "+fmt1(r.data.low),10,MUTED,true);removed.setGravity(Gravity.CENTER);removed.setPadding(0,dp(10),0,0);card.addView(removed);if(usesTieBreak(r)){TextView five=text("5-Judge Total     "+fmt(r.data.fiveTotal),10,accent,true);five.setGravity(Gravity.CENTER);five.setPadding(0,dp(5),0,0);card.addView(five);}TextView detail=text(r.detail,10,MUTED,false);detail.setPadding(0,dp(8),0,0);card.addView(detail);return card;
    }

    private void openEntryDialog(Competition c,Entry target){
        boolean edit=target!=null;Entry e=edit?target:new Entry();LinearLayout body=new LinearLayout(this);body.setOrientation(LinearLayout.VERTICAL);body.setPadding(dp(18),dp(4),dp(18),0);EditText name=input(e.name,isTeam(c)?"Team name":"Competitor name",false);EditText school=input(e.school,"School / Delegation",false);body.addView(field(isTeam(c)?"TEAM NAME":"COMPETITOR NAME",name));body.addView(field("SCHOOL / DELEGATION",school));AlertDialog d=new AlertDialog.Builder(this).setTitle(edit?"Edit "+entryLabel(c):"Add "+entryLabel(c)).setView(body).setNegativeButton("Cancel",null).setPositiveButton(edit?"Save":"Add",null).create();d.setOnShowListener(x->d.getButton(AlertDialog.BUTTON_POSITIVE).setOnClickListener(v->{String n=name.getText().toString().trim();if(n.isEmpty()){name.setError("Required");return;}e.name=n;e.school=school.getText().toString().trim();if(!edit){e.id=c.nextEntryId++;c.entries.add(e);}saveState();d.dismiss();showWorkspace();}));d.show();
    }

    private void confirmDeleteEntry(Competition c,Entry e){new AlertDialog.Builder(this).setTitle("Remove "+entryLabel(c)).setMessage("Remove "+safeName(e.name)+" from this competition?").setNegativeButton("Cancel",null).setPositiveButton("Remove",(d,w)->{c.entries.remove(e);saveState();showWorkspace();}).show();}
    private void confirmDeleteCompetition(Competition c){new AlertDialog.Builder(this).setTitle("Delete Competition").setMessage("Delete "+c.meet+" and all scoring data?").setNegativeButton("Cancel",null).setPositiveButton("Delete",(d,w)->{competitions.remove(c);activeCompetition=null;saveState();showHome();}).show();}

    private ScoreData scoreData(Entry e){
        ScoreData d=new ScoreData();d.nums=new double[5];try{for(int i=0;i<5;i++){if(e.scores[i]==null||e.scores[i].trim().isEmpty())return d;double n=Double.parseDouble(e.scores[i]);if(n<7||n>10)return d;d.nums[i]=n;}}catch(Exception ex){return d;}double[] sorted=d.nums.clone();Arrays.sort(sorted);d.low=sorted[0];d.high=sorted[4];d.score=sorted[1]+sorted[2]+sorted[3];d.penalty=Math.max(0,e.penalty);d.net=d.score-d.penalty;for(double n:d.nums)d.fiveTotal+=n;d.complete=true;return d;
    }

    private ArrayList<ResultRow> analyze(Competition c){
        ArrayList<ResultRow> rows=new ArrayList<>();for(Entry e:c.entries){ScoreData d=scoreData(e);if(d.complete){ResultRow r=new ResultRow();r.entry=e;r.data=d;rows.add(r);}}rows.sort((a,b)->{int n=Double.compare(b.data.net,a.data.net);return n!=0?n:Double.compare(b.data.fiveTotal,a.data.fiveTotal);});String lastExact=null;int lastRank=0;for(int i=0;i<rows.size();i++){ResultRow x=rows.get(i);String key=String.format(Locale.US,"%.6f|%.6f",x.data.net,x.data.fiveTotal);x.rank=key.equals(lastExact)?lastRank:i+1;lastExact=key;lastRank=x.rank;int sameFinal=0,sameExact=0;double highestFive=-1;for(ResultRow y:rows){if(eq(y.data.net,x.data.net)){sameFinal++;highestFive=Math.max(highestFive,y.data.fiveTotal);if(eq(y.data.fiveTotal,x.data.fiveTotal))sameExact++;}}if(sameExact>1){x.status="REPEAT PERFORMANCE";x.accent=RED;x.detail="Final score and 5-judge total are still tied. Repeat performance is required.";}else if(sameFinal>1&&eq(x.data.fiveTotal,highestFive)){x.status="TIE-BREAK WINNER";x.accent=BLUE_2;x.detail="Final score tied. Won the tie-break with the higher 5-judge total of "+fmt(x.data.fiveTotal)+".";}else if(sameFinal>1){x.status="TIE-BREAK APPLIED";x.accent=BRONZE;x.detail="Final score tied. Ranked by the 5-judge total of "+fmt(x.data.fiveTotal)+".";}else{x.status="RANKED";x.accent=GREEN;x.detail="Valid Score "+fmt(x.data.score)+" minus penalty "+fmt1(x.data.penalty)+" gives Final Score "+fmt(x.data.net)+".";}}return rows;
    }

    private boolean usesTieBreak(ResultRow r){return !"RANKED".equals(r.status);}
    private String remark(ResultRow r){if("REPEAT PERFORMANCE".equals(r.status))return "Repeat Performance";String medal=r.rank==1?"Gold Medal":r.rank==2?"Silver Medal":r.rank==3?"Bronze Medal":ordinal(r.rank)+" Place";if("TIE-BREAK WINNER".equals(r.status))return medal+" • Tie-Break Winner";if("TIE-BREAK APPLIED".equals(r.status))return medal+" • Tie-Break";return medal;}
    private String shortRemark(ResultRow r){if("REPEAT PERFORMANCE".equals(r.status))return "Repeat Performance";if(r.rank==1)return "Gold Medal";if(r.rank==2)return "Silver Medal";if(r.rank==3)return "Bronze Medal";return ordinal(r.rank)+" Place";}
    private int medalAccent(ResultRow r){if("REPEAT PERFORMANCE".equals(r.status))return RED;if(r.rank==1)return GOLD_2;if(r.rank==2)return SILVER;if(r.rank==3)return BRONZE;return BLUE_2;}

    private void saveResultImage(Competition c,ArrayList<ResultRow> rows){
        if(rows.isEmpty())return;try{int width=1400,header=240,meta=170,rowH=215,footer=120,height=header+meta+rows.size()*rowH+footer;Bitmap bmp=Bitmap.createBitmap(width,height,Bitmap.Config.ARGB_8888);Canvas cv=new Canvas(bmp);Paint p=new Paint(Paint.ANTI_ALIAS_FLAG);cv.drawColor(BG);p.setColor(NAVY);cv.drawRoundRect(38,35,width-38,header-18,30,30,p);Bitmap logo=BitmapFactory.decodeResource(getResources(),R.drawable.brand_logo);if(logo!=null){Rect src=new Rect(0,0,logo.getWidth(),logo.getHeight());RectF dst=new RectF(72,65,205,198);cv.drawBitmap(logo,src,dst,p);}drawText(cv,p,"Bastonero Calculator",235,108,44,WHITE,true);drawText(cv,p,"Official Tournament Result • Native Android",235,154,24,MUTED,false);drawText(cv,p,"TEST 4",235,190,21,GOLD_2,true);
            p.setColor(CARD);cv.drawRoundRect(38,header,width-38,header+meta-20,24,24,p);drawText(cv,p,c.meet,68,header+48,31,WHITE,true);drawText(cv,p,(c.date.isEmpty()?"No date":c.date)+(c.venue.isEmpty()?"":" • "+c.venue),68,header+86,21,MUTED,false);drawText(cv,p,c.level+" • "+(isTeam(c)?"Team":"Individual")+" • "+c.division+" • "+c.weapon,68,header+127,22,GOLD_2,true);
            int y=header+meta;for(ResultRow r:rows){int accent=medalAccent(r);p.setColor(CARD);cv.drawRoundRect(38,y,width-38,y+rowH-14,22,22,p);p.setStyle(Paint.Style.STROKE);p.setStrokeWidth(4);p.setColor(accent);cv.drawRoundRect(38,y,width-38,y+rowH-14,22,22,p);p.setStyle(Paint.Style.FILL);drawText(cv,p,"#"+r.rank,70,y+49,31,accent,true);drawText(cv,p,safeName(r.entry.name),150,y+45,28,WHITE,true);drawText(cv,p,"ID: "+String.format(Locale.US,"%03d",r.entry.id)+(r.entry.school.isEmpty()?"":" • "+r.entry.school),150,y+80,18,MUTED,false);drawTextRight(cv,p,remark(r),width-70,y+46,19,accent,true);String js="J1 "+fmt1(r.data.nums[0])+"   J2 "+fmt1(r.data.nums[1])+"   J3 "+fmt1(r.data.nums[2])+"   J4 "+fmt1(r.data.nums[3])+"   J5 "+fmt1(r.data.nums[4]);drawText(cv,p,js,70,y+119,18,TEXT,true);String ms="Removed "+fmt1(r.data.high)+" / "+fmt1(r.data.low)+"   •   Valid "+fmt(r.data.score)+"   •   Penalty "+fmt1(r.data.penalty)+"   •   FINAL "+fmt(r.data.net);drawText(cv,p,ms,70,y+157,19,WHITE,true);if(usesTieBreak(r))drawText(cv,p,"5-Judge Total "+fmt(r.data.fiveTotal),70,y+190,17,accent,true);y+=rowH;}
            drawText(cv,p,"Develop by Sir Hairie Laysam",width/2,height-66,20,GOLD_2,true,Paint.Align.CENTER);String file="Bastonero_Result_"+System.currentTimeMillis()+".png";if(Build.VERSION.SDK_INT>=29){ContentValues values=new ContentValues();values.put(MediaStore.Images.Media.DISPLAY_NAME,file);values.put(MediaStore.Images.Media.MIME_TYPE,"image/png");values.put(MediaStore.Images.Media.RELATIVE_PATH,"Pictures/Bastonero");Uri uri=getContentResolver().insert(MediaStore.Images.Media.EXTERNAL_CONTENT_URI,values);if(uri==null)throw new Exception("Could not create image");try(OutputStream out=getContentResolver().openOutputStream(uri)){bmp.compress(Bitmap.CompressFormat.PNG,100,out);}}else{java.io.File dir=new java.io.File(getExternalFilesDir(android.os.Environment.DIRECTORY_PICTURES),"Bastonero");dir.mkdirs();java.io.File f=new java.io.File(dir,file);try(OutputStream out=new java.io.FileOutputStream(f)){bmp.compress(Bitmap.CompressFormat.PNG,100,out);}}bmp.recycle();showSavedDialog();}catch(Exception ex){toast("Unable to save result: "+ex.getMessage());}
    }

    private void showAbout(){
