        });
        actions.addView(cancel,new LinearLayout.LayoutParams(0,dp(48),1f));
        LinearLayout.LayoutParams sv = new LinearLayout.LayoutParams(0,dp(48),1.3f); sv.setMargins(dp(10),0,0,0); actions.addView(save,sv);
        content.addView(actions);
    }

    private void showWorkspace() {
        if (activeCompetition == null) { showHome(); return; }
        screen = Screen.WORKSPACE; clearContent();
        Competition c = activeCompetition;
        addHeading(c.meet, c.level+" • "+(isTeam(c)?"Team":"Individual")+" • "+c.division+" • "+c.weapon);
        content.addView(summaryCard(c), fullMargins(0,0,0,dp(10)));
        content.addView(statusCards(c), fullMargins(0,0,0,dp(10)));
        content.addView(rosterPanel(c), fullMargins(0,0,0,dp(10)));
        if (c.scoringStarted) {
            content.addView(scoringPanel(c), fullMargins(0,0,0,dp(10)));
            content.addView(rankingPanel(c), fullMargins(0,0,0,dp(10)));
        }
    }

    private View summaryCard(Competition c) {
        LinearLayout card = card();
        TextView e = text("ACTIVE COMPETITION",10,BLUE,true); card.addView(e);
        TextView h = text(c.meet,20,NAVY,true); h.setPadding(0,dp(2),0,dp(4)); card.addView(h);
        card.addView(text((c.date.isEmpty()?"No date":c.date)+(c.venue.isEmpty()?"":" • "+c.venue),12,MUTED,false));
        LinearLayout chips = new LinearLayout(this); chips.setOrientation(LinearLayout.VERTICAL); chips.setPadding(0,dp(8),0,dp(8));
        chips.addView(metaLine("Level",c.level)); chips.addView(metaLine("Competition Type",isTeam(c)?"Team":"Individual")); chips.addView(metaLine("Division",c.division)); chips.addView(metaLine("Anyo Category",c.weapon));
        card.addView(chips);
        LinearLayout actions = new LinearLayout(this); actions.setOrientation(LinearLayout.HORIZONTAL);
        Button del = smallButton("Delete Competition", RED); del.setOnClickListener(v -> confirmDeleteCompetition(c));
        Button edit = smallButton("Edit Competition", GREEN); edit.setOnClickListener(v -> {editingCompetition=c;showSetup();});
        actions.addView(del,new LinearLayout.LayoutParams(0,dp(42),1f)); LinearLayout.LayoutParams ep=new LinearLayout.LayoutParams(0,dp(42),1f);ep.setMargins(dp(8),0,0,0);actions.addView(edit,ep);
        card.addView(actions);
        return card;
    }

    private View statusCards(Competition c) {
        LinearLayout box = new LinearLayout(this); box.setOrientation(LinearLayout.VERTICAL);
        LinearLayout r1 = new LinearLayout(this), r2 = new LinearLayout(this); r1.setOrientation(LinearLayout.HORIZONTAL); r2.setOrientation(LinearLayout.HORIZONTAL);
        ArrayList<ResultRow> rows = analyze(c);
        String leader = rows.isEmpty()?"—":safeName(rows.get(0).entry.name);
        String leadScore = rows.isEmpty()?"—":fmt(rows.get(0).data.net);
        r1.addView(stat("Competitors / Teams",String.valueOf(c.entries.size())),weightCard());
        LinearLayout.LayoutParams p = weightCard(); p.setMargins(dp(8),0,0,0);r1.addView(stat("Completed Scores",String.valueOf(rows.size())),p);
        r2.addView(stat("Current Leader",leader),weightCard());
        LinearLayout.LayoutParams p2=weightCard();p2.setMargins(dp(8),0,0,0);r2.addView(stat("Leading Score",leadScore),p2);
        box.addView(r1); LinearLayout.LayoutParams rr=new LinearLayout.LayoutParams(-1,-2);rr.setMargins(0,dp(8),0,0);box.addView(r2,rr); return box;
    }

    private View rosterPanel(Competition c) {
        LinearLayout panel = card();
        LinearLayout head = new LinearLayout(this); head.setOrientation(LinearLayout.HORIZONTAL); head.setGravity(Gravity.CENTER_VERTICAL);
        LinearLayout txt = new LinearLayout(this); txt.setOrientation(LinearLayout.VERTICAL);
        txt.addView(text(isTeam(c)?"Teams":"Competitors",17,NAVY,true)); txt.addView(text(c.scoringStarted?"Registration is locked while scoring.":"Add all competitors first, then proceed to judge scoring.",11,MUTED,false));
        head.addView(txt,new LinearLayout.LayoutParams(0,-2,1f));
        if(!c.scoringStarted){Button add=smallButton("+",BLUE);add.setTextSize(22);add.setOnClickListener(v->openEntryDialog(c,null));head.addView(add,new LinearLayout.LayoutParams(dp(48),dp(44)));}
        panel.addView(head);
        if(c.entries.isEmpty()){TextView empty=text("No "+entryLabel(c).toLowerCase()+" yet.",13,MUTED,false);empty.setGravity(Gravity.CENTER);empty.setPadding(0,dp(18),0,dp(18));panel.addView(empty);} else {
            for(Entry e:c.entries) panel.addView(rosterRow(c,e));
        }
        if(c.scoringStarted){Button editReg=primaryButton("Edit Registration",Color.rgb(59,130,246));editReg.setOnClickListener(v->{c.scoringStarted=false;saveState();toast("Registration reopened");showWorkspace();});panel.addView(editReg,fullMargins(0,dp(10),0,0));}
        else {Button proceed=primaryButton("Proceed to Judge Scoring",BLUE);proceed.setEnabled(!c.entries.isEmpty());proceed.setAlpha(c.entries.isEmpty()?0.5f:1f);proceed.setOnClickListener(v->{if(c.entries.isEmpty())return;c.scoringStarted=true;saveState();showWorkspace();});panel.addView(proceed,fullMargins(0,dp(10),0,0));}
        return panel;
    }

    private View rosterRow(Competition c, Entry e) {
        LinearLayout row = new LinearLayout(this); row.setOrientation(LinearLayout.VERTICAL); row.setPadding(dp(10),dp(10),dp(10),dp(10)); row.setBackground(round(Color.rgb(248,250,252),dp(12),LINE));
        LinearLayout top=new LinearLayout(this);top.setOrientation(LinearLayout.HORIZONTAL);top.setGravity(Gravity.CENTER_VERTICAL);
        LinearLayout words=new LinearLayout(this);words.setOrientation(LinearLayout.VERTICAL);words.addView(text(safeName(e.name),15,TEXT,true));words.addView(text(e.school.isEmpty()?"—":e.school,11,MUTED,false));top.addView(words,new LinearLayout.LayoutParams(0,-2,1f));
        ScoreData d=scoreData(e);TextView st=text(d.complete?"SCORED":"PENDING",10,d.complete?GREEN:MUTED,true);st.setPadding(dp(8),dp(5),dp(8),dp(5));st.setBackground(round(d.complete?Color.rgb(220,252,231):Color.rgb(241,245,249),dp(999),0));top.addView(st);row.addView(top);
        if(!c.scoringStarted){LinearLayout a=new LinearLayout(this);a.setOrientation(LinearLayout.HORIZONTAL);a.setPadding(0,dp(8),0,0);Button edit=smallButton("Edit",GREEN);edit.setOnClickListener(v->openEntryDialog(c,e));Button del=smallButton("Remove",RED);del.setOnClickListener(v->confirmDeleteEntry(c,e));a.addView(edit,new LinearLayout.LayoutParams(0,dp(38),1f));LinearLayout.LayoutParams dp1=new LinearLayout.LayoutParams(0,dp(38),1f);dp1.setMargins(dp(8),0,0,0);a.addView(del,dp1);row.addView(a);}
        LinearLayout.LayoutParams p=new LinearLayout.LayoutParams(-1,-2);p.setMargins(0,dp(8),0,0);row.setLayoutParams(p);return row;
    }

    private View scoringPanel(Competition c) {
        LinearLayout panel=card();
        TextView banner=text("JUDGE SCORING PHASE\nRegistration is locked while scoring.",12,Color.rgb(30,58,138),true);banner.setPadding(dp(12),dp(10),dp(12),dp(10));banner.setBackground(round(Color.rgb(239,246,255),dp(12),Color.rgb(191,219,254)));panel.addView(banner);
        TextView h=text("Judge Scoring",17,NAVY,true);h.setPadding(0,dp(14),0,dp(4));panel.addView(h);panel.addView(text("Valid judge score: 7.0 to 10.0. Highest and lowest are removed; the middle three are added. Penalty is then subtracted.",11,MUTED,false));
        for(int i=0;i<c.entries.size();i++) panel.addView(scoreCard(c,c.entries.get(i),i),fullMargins(0,dp(10),0,0));
        return panel;
    }

    private View scoreCard(Competition c, Entry e, int index) {
        LinearLayout card=card(); card.setBackground(round(Color.WHITE,dp(14),LINE));
        LinearLayout head=new LinearLayout(this);head.setOrientation(LinearLayout.HORIZONTAL);head.setGravity(Gravity.CENTER_VERTICAL);
        TextView num=text(String.valueOf(index+1),14,BLUE,true);num.setGravity(Gravity.CENTER);num.setBackground(round(Color.rgb(239,246,255),dp(999),0));head.addView(num,new LinearLayout.LayoutParams(dp(36),dp(36)));
        LinearLayout nm=new LinearLayout(this);nm.setOrientation(LinearLayout.VERTICAL);nm.setPadding(dp(10),0,0,0);nm.addView(text(safeName(e.name),17,NAVY,true));nm.addView(text(e.school.isEmpty()?"—":e.school,11,MUTED,false));head.addView(nm,new LinearLayout.LayoutParams(0,-2,1f));card.addView(head);

        LinearLayout scores1=new LinearLayout(this);scores1.setOrientation(LinearLayout.HORIZONTAL);scores1.setPadding(0,dp(10),0,0);
        ArrayList<EditText> inputs=new ArrayList<>();
        for(int i=0;i<5;i++){
            final int idx=i;
            EditText inp=input(e.scores[i],"J"+(i+1),true);inp.setGravity(Gravity.CENTER);inp.setTextSize(17);inp.setSelectAllOnFocus(true);inp.setSingleLine(true);inp.setImeOptions(i<4?EditorInfo.IME_ACTION_NEXT:EditorInfo.IME_ACTION_DONE);
            inp.addTextChangedListener(new SimpleWatcher(){public void afterTextChanged(Editable s){e.scores[idx]=s.toString();saveState();}});
            inp.setOnFocusChangeListener((v,has)->{if(!has)showWorkspace();});
            inputs.add(inp);LinearLayout.LayoutParams ip=new LinearLayout.LayoutParams(0,dp(54),1f);if(i>0)ip.setMargins(dp(5),0,0,0);scores1.addView(inp,ip);
        }
        card.addView(scores1);

        ScoreData d=scoreData(e);
